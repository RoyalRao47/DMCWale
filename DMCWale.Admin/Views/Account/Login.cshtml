@model LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "_LoginLayout";
}

<div class="login-container">
    <div class="login-header login-caret">
        <div class="login-content">
            <a asp-controller="Account" asp-action="Login" class="logo">
                <img src="~/dmcwale-logo.jpg" width="140" alt="DMCWale" />
            </a>
            <p class="description">Sign in to continue to the DMCWale CMS.</p>
        </div>
    </div>

    <div class="login-form">
        <div class="login-content">
            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success">@successMessage</div>
            }

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" role="form">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="form-group">
                    <div class="input-group">
                        <div class="input-group-addon">
                            <i class="entypo-user"></i>
                        </div>
                        <input asp-for="UsernameOrEmail" class="form-control" placeholder="Username or Email" autocomplete="username" />
                    </div>
                    <span asp-validation-for="UsernameOrEmail" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <div class="input-group">
                        <div class="input-group-addon">
                            <i class="entypo-key"></i>
                        </div>
                        <input asp-for="Password" class="form-control" placeholder="Password" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group text-left">
                    <label class="checkbox-inline">
                        <input asp-for="RememberMe" />
                        Remember Me
                    </label>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary btn-block btn-login">
                        <i class="entypo-login"></i>
                        Login
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-sm-3 col-xs-6">
        <div class="tile-stats tile-blue">
            <div class="icon"><i class="entypo-gauge"></i></div>
            <div class="num">CMS</div>
            <h3>Dashboard</h3>
            <p>Your role-specific workspace is ready.</p>
        </div>
    </div>
    <div class="col-sm-3 col-xs-6">
        <div class="tile-stats tile-green">
            <div class="icon"><i class="entypo-lock"></i></div>
            <div class="num">Identity</div>
            <h3>Secure Login</h3>
            <p>Authentication is handled by ASP.NET Core Identity.</p>
        </div>
    </div>
    <div class="col-sm-3 col-xs-6">
        <div class="tile-stats tile-aqua">
            <div class="icon"><i class="entypo-users"></i></div>
            <div class="num">Roles</div>
            <h3>Access</h3>
            <p>Dashboards are protected by role authorization.</p>
        </div>
    </div>
    <div class="col-sm-3 col-xs-6">
        <div class="tile-stats tile-red">
            <div class="icon"><i class="entypo-db"></i></div>
            <div class="num">EF</div>
            <h3>Code First</h3>
            <p>Identity and profile tables are migration-ready.</p>
        </div>
    </div>
</div>

            </div>

            <hr />

            @RenderBody()

            <footer class="main">
                &copy; @DateTime.Now.Year DMCWale Admin CMS
            </footer>
        </div>
    </div>

    <script src="~/assets/js/jquery-1.11.3.min.js"></script>
    <script src="~/assets/js/gsap/TweenMax.min.js"></script>
    <script src="~/assets/js/jquery-ui/js/jquery-ui-1.10.3.minimal.min.js"></script>
    <script src="~/assets/js/bootstrap.js"></script>
    <script src="~/assets/js/joinable.js"></script>
    <script src="~/assets/js/resizeable.js"></script>
    <script src="~/assets/js/neon-api.js"></script>
    <script src="~/assets/js/cookies.min.js"></script>
    <script>
        (function () {
            var currentPath = normalizePath(window.location.pathname);
            var currentArea = getFirstPathSegment(currentPath);
            var links = document.querySelectorAll('#main-menu a[href]:not([href="#"])');
            var activeLink = null;

            links.forEach(function (link) {
                var linkPath = normalizePath(new URL(link.getAttribute('href'), window.location.origin).pathname);

                if (linkPath === currentPath) {
                    activeLink = link;
                    return;
                }

                if (!activeLink && getFirstPathSegment(linkPath) === currentArea) {
                    activeLink = link;
                }
            });

            if (!activeLink) {
                return;
            }

            var activeItem = activeLink.closest('li');
            if (activeItem) {
                activeItem.classList.add('active');
            }

            var parentMenu = activeLink.closest('ul');
            while (parentMenu && parentMenu.id !== 'main-menu') {
                parentMenu.classList.add('visible');

                var parentItem = parentMenu.closest('li');
                if (parentItem) {
                    parentItem.classList.add('active', 'opened');
                }

                parentMenu = parentItem ? parentItem.parentElement.closest('ul') : null;
            }

            function normalizePath(path) {
                path = (path || '/').toLowerCase().replace(/\/+$/, '');
                return path || '/';
            }

            function getFirstPathSegment(path) {
                return normalizePath(path).split('/').filter(Boolean)[0] || '';
            }
        })();
    </script>
    <script src="~/assets/js/neon-custom.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    private bool CanPage(string permission)
    {
        if (permission == PagePermissionConstants.ProfileView &&
            User.Identity?.IsAuthenticated == true)
        {
            return true;
        }

        return User.IsInRole(RoleConstants.Admin) ||
            User.HasClaim(PagePermissionConstants.ClaimType, permission);
    }

    private bool CanAnyPage(params string[] permissions)
    {
        return permissions.Any(CanPage);
    }
}


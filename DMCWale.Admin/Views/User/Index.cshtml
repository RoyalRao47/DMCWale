@model UserListViewModel

@{
    ViewData["Title"] = "Users";
}

<div class="row">
    <div class="col-sm-12">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <form id="userStatusAntiForgeryForm" class="hidden">
            @Html.AntiForgeryToken()
        </form>
        <div id="userStatusNotification" class="alert hidden" role="alert"></div>

        <div class="panel panel-primary">
            <div class="panel-heading">
                <div class="panel-title">User List</div>
                <div class="panel-options">
                    <a asp-action="Create" class="btn btn-primary btn-sm">
                        <i class="entypo-user-add"></i>
                        Create User
                    </a>
                </div>
            </div>
            <div class="panel-body">
                <form asp-action="Index" method="get" class="form-inline" role="form">
                    <div class="form-group">
                        <label asp-for="RoleName" class="control-label">Role</label>
                        <select asp-for="RoleName" asp-items="Model.Roles" class="form-control">
                            <option value="">All roles</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="entypo-search"></i>
                        Filter
                    </button>
                    <a asp-action="Index" class="btn btn-default">Clear</a>
                </form>
            </div>

            <table class="table table-bordered table-striped table-hover">
                <thead>
                    <tr>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Mobile</th>
                        <th>Agent/Supplier Code</th>
                        <th>Role</th>
                        <th>Active</th>
                        <th>Left</th>
                        <th>Added</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Users.Count == 0)
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted">No users found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@user.FirstName</td>
                                <td>@user.LastName</td>
                            <td>@user.Username</td>
                            <td>@user.Email</td>
                            <td>@user.Mobile</td>
                            <td>@user.AgentSupplierCode</td>
                            <td>@user.RoleName</td>
                            <td>
                                <input type="checkbox"
                                       class="js-user-status-toggle"
                                       data-user-id="@user.Id"
                                       data-toggle-url="@Url.Action("ToggleActive", "User")"
                                       data-toggle-kind="active"
                                       @(user.IsActive ? "checked" : string.Empty) />
                            </td>
                            <td>
                                <input type="checkbox"
                                       class="js-user-status-toggle"
                                       data-user-id="@user.Id"
                                       data-toggle-url="@Url.Action("ToggleLeft", "User")"
                                       data-toggle-kind="left"
                                       @(user.IsLeft ? "checked" : string.Empty) />
                            </td>
                            <td>@user.AddDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-right">
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-info btn-sm">
                                    <i class="entypo-pencil"></i>
                                    Edit
                                </a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/user-management.js" asp-append-version="true"></script>
}
